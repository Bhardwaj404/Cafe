// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
}

enum OrderStatus {
  PLACED
  PREPARING
  READY_FOR_PICKUP
  COLLECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_INITIATED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  CASH_AT_COUNTER
}

enum DietType {
  VEG
  NON_VEG
  EGG
}

enum CustomType {
  SIZE
  EXTRA
  SPICE_LEVEL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  studentId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@index([email])
}

model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  icon         String     @default("🍽️")
  displayOrder Int        @default(0)
  items        MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Int // in paise (1 INR = 100 paise)
  prepTime    Int // in minutes
  dietType    DietType @default(VEG)
  categoryId  String
  imageUrl    String
  isAvailable Boolean  @default(true)
  stockCount  Int? // null = unlimited
  isPopular   Boolean  @default(false)
  orderCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       Category            @relation(fields: [categoryId], references: [id])
  customizations ItemCustomization[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isPopular])
}

model ItemCustomization {
  id            String     @id @default(cuid())
  menuItemId    String
  type          CustomType
  label         String
  options       String // JSON array of { label, priceModifier }
  required      Boolean    @default(false)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  status      OrderStatus @default(PLACED)
  pickupSlotId String
  totalAmount Int // paise
  gstAmount   Int // paise
  note        String?
  idempotencyKey String? @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  pickupSlot PickupSlot  @relation(fields: [pickupSlotId], references: [id])
  items      OrderItem[]
  payment    Payment?

  @@index([userId])
  @@index([status])
  @@index([pickupSlotId])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  menuItemId     String
  quantity       Int
  unitPrice      Int // paise at time of order
  customizations String  @default("[]") // JSON
  instructions   String?

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Int // paise
  gatewayRef  String?
  gatewayOrderId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
}

model PickupSlot {
  id           String   @id @default(cuid())
  startTime    DateTime
  endTime      DateTime
  capacity     Int      @default(20)
  currentCount Int      @default(0)
  date         String // "YYYY-MM-DD" for indexing

  orders Order[]

  @@unique([startTime])
  @@index([date])
}

model CafeteriaSettings {
  id                String   @id @default("singleton")
  openTime          String   @default("07:00") // HH:MM
  closeTime         String   @default("22:00") // HH:MM
  slotLengthMinutes Int      @default(15)
  slotCapacity      Int      @default(20)
  bufferMinutes     Int      @default(10) // extra buffer after prep time
  updatedAt         DateTime @updatedAt
}
